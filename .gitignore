# SwiftPM build products
/.build/
.swiftpm/
*.dSYM/

# Hand-assembled app bundle (scripts/build-app.sh)
/Squish.app/

# Build-time vendored helper binaries and their relocated dependencies
# (scripts/vendor-codecs.sh regenerates these; they are not source)
/vendor/bin/
/vendor/lib/

# GPLv3 corresponding-source tarball for pngquant, fetched on demand by
# scripts/fetch-gpl-sources.sh — not committed, but reproducible with one
# command. See ATTRIBUTION.md for the written offer this satisfies.
/gpl-sources/

# Test fixtures are generated, not authored (tests/make-fixtures.sh regenerates them)
/tests/fixtures/

# Release packaging output (RELEASE.md's ditto/shasum steps) - the built artifact belongs on a
# GitHub release, not in git history.
/Squish_*.zip
/checksums.txt

# Notarization credentials, should one ever be added locally (see RELEASE.md's "Developer ID"
# section) - never committed.
.env
*.env

# Editor/IDE local state - nobody else's workspace settings belong in this repo.
.vscode/
.idea/

.DS_Store
**/.DS_Store

# Disk images produced by scripts/build-dmg.sh
/dist/
